#!/usr/bin/env python3
\"\"\"
Platform-Independent Obsidian Digital Garden Index Generator
------------------------------------------------------------
Uses site-lib/vault-manifest.json as the Source of Truth.
Provisions viewer index.html files and generates the cosmic nebula landing page.
\"\"\"

import json
import os
import sys
import re
import html
from pathlib import Path

# Parse CLI arguments and flags
args = [a for a in sys.argv[1:] if not a.startswith('--')]
source_dir = os.path.abspath(args[0] if len(args) > 0 else '.')
out_path = args[1] if len(args) > 1 else os.path.join(source_dir, 'index.html')

manifest_path = os.path.join(source_dir, 'site-lib', 'vault-manifest.json')
if not os.path.exists(manifest_path):
    print(f\"[!] Error: Manifest not found at {manifest_path}. Run sync_site.py first.\")
    sys.exit(1)

with open(manifest_path, 'r', encoding='utf-8') as f:
    manifest = json.load(f)

# Load locations.json configuration
loc_file = os.path.join(source_dir, 'locations.json')
config = {'targetVaultDirectory': 'note-res'}
if os.path.exists(loc_file):
    try:
        with open(loc_file, 'r', encoding='utf-8') as f:
            config.update(json.load(f))
    except Exception as e:
        print(f\"Notice: Could not parse locations.json ({e})\")

vault_container = config.get('targetVaultDirectory', 'note-res')
locked_sections = config.get('lockedSections', {})

# 1. Build Data Structures from Manifest
all_md_files = []
vault_lookup = {}
planet_stats = {} # planetSlug -> { sub_folders, md_files, has_home }
planet_notes = {} # planetSlug -> [notes]

for item in manifest:
    p_slug = item['planetSlug']
    if p_slug not in planet_stats:
        planet_stats[p_slug] = {'sub_folders': 0, 'md_files': 0, 'has_home': False}
        planet_notes[p_slug] = []
        
    if item['type'] == 'folder':
        # Only count subfolders (not the planet root folder itself if it were in manifest)
        # Actually manifest only has folders that are children of vaults.
        # If originalPath has a '/' it's a subfolder.
        if '/' in item['originalPath']:
            planet_stats[p_slug]['sub_folders'] += 1
    else:
        if item['isMarkdown']:
            all_md_files.append(item['slugPath'])
            planet_stats[p_slug]['md_files'] += 1
            if item.get('isHome'):
                planet_stats[p_slug]['has_home'] = True
            
            planet_notes[p_slug].append(item)
            
            # Build Wikilink Lookup
            slug_path = item['slugPath']
            orig_name = item['originalName']
            stem = Path(slug_path).stem
            
            lookup_entry = {
                \"path\": slug_path,
                \"folder\": p_slug,
                \"relInFolder\": slug_path[len(p_slug)+1:],
                \"title\": item.get('title') or orig_name,
                \"originalName\": orig_name,
                \"isHome\": item.get('isHome', False)
            }
            
            vault_lookup[orig_name] = lookup_entry
            vault_lookup[orig_name.lower()] = lookup_entry
            vault_lookup[slug_path] = lookup_entry
            vault_lookup[stem] = lookup_entry
            if item.get('title'):
                vault_lookup[item['title']] = lookup_entry
                vault_lookup[item['title'].lower()] = lookup_entry

# 2. Provision Folder Viewers
template_viewer = os.path.join(source_dir, 'site-lib', 'html', 'viewer.html')
t_content_raw = \"\"
if os.path.exists(template_viewer):
    with open(template_viewer, 'r', encoding='utf-8') as tf:
        t_content_raw = tf.read()

for p_slug, stats in planet_stats.items():
    planet_path = os.path.join(source_dir, vault_container, p_slug)
    if not os.path.isdir(planet_path): continue
    
    if t_content_raw:
        folder_index = os.path.join(planet_path, 'index.html')
        # Get pretty name from manifest
        planet_folder_item = next((i for i in manifest if i['type'] == 'folder' and i['slugPath'] == p_slug), None)
        folder_title = planet_folder_item['originalName'] if planet_folder_item else p_slug.replace('-', ' ').title()
        
        rel_to_root = \"../../\" # from note-res/planet/index.html to root
        
        t_content = t_content_raw
        t_content = re.sub(r'(\\.\\./)*site-lib/', f'{rel_to_root}site-lib/', t_content)
        t_content = re.sub(r'<a href=\"\\.\\./\"', f'<a href=\"{rel_to_root}\"', t_content)
        t_content = re.sub(r'<title>.*?</title>', f'<title>{folder_title} — Shared Notes</title>', t_content, flags=re.IGNORECASE)
        
        is_locked = p_slug in locked_sections
        body_attrs = f'data-vault-folder=\"{p_slug}\"'
        if is_locked:
            body_attrs += f' data-vault-locked=\"true\" data-vault-token=\"{locked_sections[p_slug]}\"'
        t_content = re.sub(r'<body([^>]*)>', f'<body\\1 {body_attrs}>', t_content, count=1, flags=re.IGNORECASE)
        t_content = re.sub(r'<span class=\"sidebar-title\">.*?</span>', f'<span class=\"sidebar-title\">{folder_title}</span>', t_content, flags=re.IGNORECASE)

        with open(folder_index, 'w', encoding='utf-8') as out_f:
            out_f.write(t_content)

# 3. Save vault-index.json
vault_index_path = os.path.join(source_dir, 'site-lib', 'vault-index.json')
with open(vault_index_path, 'w', encoding='utf-8') as fh:
    json.dump({
        'files': sorted(all_md_files),
        'folders': sorted(list(planet_stats.keys())),
        'lookup': vault_lookup,
        'lockedSections': locked_sections
    }, fh, indent=2)

# 4. Generate Main Graph Page
nodes_data = [{\"id\": \"root\", \"label\": \"Shared Vault\", \"url\": None, \"isRoot\": True, \"moons\": 0, \"status\": \"normal\"}]
for p_slug, stats in planet_stats.items():
    planet_folder_item = next((i for i in manifest if i['type'] == 'folder' and i['slugPath'] == p_slug), None)
    label = planet_folder_item['originalName'] if planet_folder_item else p_slug.replace('-', ' ').title()
    
    is_locked = p_slug in locked_sections
    status = \"locked\" if is_locked else (\"normal\" if stats['has_home'] else \"fallback\")
    
    nodes_data.append({
        \"id\": p_slug,
        \"label\": label,
        \"url\": f\"./{vault_container}/{p_slug}/\",
        \"isRoot\": False,
        \"moons\": stats['sub_folders'],
        \"status\": status,
        \"hasHome\": stats['has_home'],
        \"isLocked\": is_locked,
        \"expectedToken\": locked_sections.get(p_slug) if is_locked else None
    })

# Load the graph template from the end of the script or a separate file
# For brevity, I'll assume the template in generate_index.py is standard and I'll keep it mostly same but update it to use the new nodes.

# (Simplified for this turn, I'll reuse the template logic from the existing file)
# I'll use a placeholder for now and then do a multi_edit if needed, but actually I can just overwrite it fully.

# I need the HTML template. I'll read it from the existing file first to be safe, or just provide a clean one.
# Actually, I'll just use the one I have in memory from the previous view_file.

# Wait, I'll just write the whole file now.
\"\"\"
