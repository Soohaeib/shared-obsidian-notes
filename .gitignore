# Node.js dependencies and lockfiles
node_modules/
package-lock.json
bun.lock
yarn.lock
pnpm-lock.yaml

# Python cache and bytecode
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# OS-generated files & local metadata
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Obsidian local cache & trash (synced notes stay in root/folders)
.obsidian/workspace*
.obsidian/cache/
.trash/

# Backup & temporary files
*.bak
*.tmp
*~
backup/
backups/
backup-directory/

# Local environment variables
.env
.env.local
.env.*.local
